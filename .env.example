# Salin ke .env.local (lokal) atau isi di Vercel > Settings > Environment Variables. JANGAN commit file .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Hanya dipakai di server (route API, skrip). Jangan pernah diberi awalan NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Cron mengirim "Authorization: Bearer <CRON_SECRET>". Isi dengan teks acak panjang.
CRON_SECRET=

# Jurnal (Mekari Jurnal). Nama variabel mengikuti tutorial PDF "Akses API Jurnal".
JURNAL_BASE_URL=https://api.mekari.com
JURNAL_CLIENT_ID=
JURNAL_CLIENT_SECRET=

# Password awal untuk akun yang dibuat lewat skrip atau tombol "Password awal". Wajib diganti saat login pertama.
INITIAL_PASSWORD=
